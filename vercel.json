{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/pncp/:path*", "destination": "https://pncp.gov.br/api/consulta/:path*" },
    { "source": "/api/compras/:path*", "destination": "https://dadosabertos.compras.gov.br/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
